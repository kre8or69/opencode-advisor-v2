{
  "name": "@local/opencode-advisor-v2",
  "version": "3.0.0-local.0",
  "private": true,
  "description": "OpenCode plugin — advisor() tool via a hidden internal agent",
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist/plugin.js",
    "dist/plugin.d.ts"
  ],
  "scripts": {
    "build": "node build.mjs all",
    "build:plugin": "node build.mjs plugin",
    "build:tests": "node build.mjs tests",
    "tests": "c8 --include=src/plugin.ts --exclude-after-remap --reporter=text --reporter=lcov ava 'tests/native.test.js' --verbose"
  },
  "keywords": [
    "opencode",
    "plugin",
    "advisor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StefanoBalocco/opencode-advisor.git"
  },
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "2.1.4"
  },
  "devDependencies": {
    "@opencode/cli": "2.1.4",
    "@types/json-schema": "^7.0.15",
    "@types/node": "~24",
    "ava": "~6",
    "c8": "~12",
    "typescript": "~6"
  }
}
